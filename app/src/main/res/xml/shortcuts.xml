<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_page"
        android:shortcutId="new_page"
        android:shortcutLongLabel="@string/shortcut_new_page_long"
        android:shortcutShortLabel="@string/shortcut_new_page">
        <intent
            android:action="com.manuscript.action.NEW_PAGE"
            android:targetClass="com.manuscript.MainActivity"
            android:targetPackage="@string/application_id" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_note"
        android:shortcutId="quick_note"
        android:shortcutLongLabel="@string/shortcut_quick_note_long"
        android:shortcutShortLabel="@string/shortcut_quick_note">
        <intent
            android:action="com.manuscript.action.QUICK_NOTE"
            android:targetClass="com.manuscript.MainActivity"
            android:targetPackage="@string/application_id" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutId="search"
        android:shortcutLongLabel="@string/shortcut_search_long"
        android:shortcutShortLabel="@string/shortcut_search">
        <intent
            android:action="com.manuscript.action.SEARCH"
            android:targetClass="com.manuscript.MainActivity"
            android:targetPackage="@string/application_id" />
    </shortcut>
</shortcuts>
